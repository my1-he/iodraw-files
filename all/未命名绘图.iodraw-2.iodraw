<mxfile host="" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) ioDraw.com/3.6.1 Chrome/124.0.6367.49 Electron/30.0.0 Safari/537.36" version="24.7.17">
  <diagram name="第 1 页" id="9w6vAxOxqMG-IDMcBhHk">
    <mxGraphModel dx="4367" dy="3929" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph LR\n    %% 采用从左到右布局，用左侧节点模拟“层级标签”\n    subgraph Architecture_Map [\&quot;IPv4 解析系统分层架构\&quot;]\n        direction TB\n\n        %% 左侧垂直层级标签锚点\n        subgraph Labels [\&quot;层级定义\&quot;]\n            direction TB\n            Tag1[\&quot;控制驱动层&lt;br&gt;(main.c)\&quot;] ~~~ Tag2[\&quot;数据源层\&quot;] ~~~ Tag3[\&quot;解析引擎层\&quot;] ~~~ Tag4[\&quot;展示层\&quot;]\n        end\n\n        %% 右侧核心组件视图\n        subgraph Core_Blocks [\&quot;核心组件架构\&quot;]\n            direction TB\n            \n            %% 控制层\n            subgraph L1 [\&quot; \&quot;]\n                L1_M[\&quot;菜单交互模块\&quot;]\n                L1_S[\&quot;测试调度模块\&quot;]\n            end\n\n            %% 数据源层\n            subgraph L2 [\&quot; \&quot;]\n                L2_Mat[\&quot;静态测试矩阵 (9个用例)\&quot;]\n                L2_Cap[\&quot;libpcap 实时捕获\&quot;]\n            end\n\n            %% 解析引擎层\n            subgraph L3 [\&quot; \&quot;]\n                subgraph L3_Parser [\&quot;parse_ip_header()\&quot;]\n                    direction LR\n                    L3_D[\&quot;7 层防御\&quot;]\n                    L3_C[\&quot;字节序/地址转换\&quot;]\n                end\n            end\n\n            %% 展示层\n            subgraph L4 [\&quot; \&quot;]\n                direction LR\n                L4_H[\&quot;Hex Dump\&quot;] --- L4_T[\&quot;结构化表格\&quot;] --- L4_E[\&quot;错误输出\&quot;]\n            end\n\n            %% 组件数据流\n            L1_M --&gt; L2_Mat\n            L1_S --&gt; L2_Cap\n            L2_Mat --&gt;|buffer + len| L3_Parser\n            L2_Cap --&gt;|buffer + len| L3_Parser\n            L3_Parser --&gt;|结果 / 错误码| L4_H\n        end\n    end\n\n    %% 弱化左侧标签的连线，仅做排版对齐\n    Tag1 -.-&gt; L1\n    Tag2 -.-&gt; L2\n    Tag3 -.-&gt; L3\n    Tag4 -.-&gt; L4\n\n    %% 样式微调\n    style Labels fill:none,stroke:none\n    style Tag1 fill:#f5f5f5,stroke:#d9d9d9\n    style Tag2 fill:#f5f5f5,stroke:#d9d9d9\n    style Tag3 fill:#f5f5f5,stroke:#d9d9d9\n    style Tag4 fill:#f5f5f5,stroke:#d9d9d9\n    style L1 fill:#f9f0ff,stroke:#d3adf7\n    style L2 fill:#e6f7ff,stroke:#91d5ff\n    style L3 fill:#fff7e6,stroke:#ffd591\n    style L4 fill:#f6ffed,stroke:#b7eb8f&quot;&#xa;}" id="jz_2psxUor58SzehUI2Y-36">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;imageAspect=1;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-120" y="-70" width="924.21875" height="1571.2666015625" as="geometry" />
